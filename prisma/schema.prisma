// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id        Int           @id @default(autoincrement())
  email     String        @unique
  name      String?
  password  String        // You'll need this for your login logic!
  chats     ChatSession[] // This connects the user to their history
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}


model ChatSession {
  id        String    @id @default(uuid()) // UUIDs are better for security than 1, 2, 3
  title     String    @default("New Question")
  createdAt DateTime  @default(now())
  
  // Relationship: Each chat belongs to one user
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  
  // Relationship: Each chat has many messages
  messages  Message[]
}

model Message {
  id            String      @id @default(uuid())
  role          String      // This will be "user" or "assistant"
  content       String      @db.Text // Use @db.Text so long AI answers don't crash the DB
  imageUrl      String?     // Optional: For your OCR feature
  createdAt     DateTime    @default(now())

  // Connection to the session
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id])
}